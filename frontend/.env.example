# Template for local environment settings. Copy it to `.env` (git-ignored) and adjust if needed:
#   Copy-Item .env.example .env
# Only non-sensitive values belong here: everything prefixed with VITE_ is visible in the browser.

# Base URL of the PIM backend, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Development stand-ins for the user's permissions until authentication exists (feature 004).
# Not secrets: they only tell the backend what the current developer may do. Uncomment to use.
# Create attributes:
# VITE_DEV_PERMISSIONS=ATTRIBUTE_CREATE
# Give manual system IDs to attributes and lists of values (feature 003):
# VITE_DEV_MANUAL_ID_PERMISSIONS=ATTRIBUTE,LIST_OF_VALUES
